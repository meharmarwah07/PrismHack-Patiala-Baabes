<?xml version="1.0" encoding="utf-8"?>
<!-- One row in SavedWorkflowsActivity's runtime-built list (no RecyclerView dependency in this module — see dialog_promote_slot_row.xml for the existing precedent). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_workflow_row"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/workflowDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="?attr/caloColorTextPrimary"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/workflowUsed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/caloColorTextSecondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/workflowLastUsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/caloColorTextSecondary"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
