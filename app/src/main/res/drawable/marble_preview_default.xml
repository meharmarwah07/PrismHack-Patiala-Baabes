<?xml version="1.0" encoding="utf-8"?>
<!--
  A fixed-color preview swatch for the "Default" option on the Themes
  screen — deliberately literal colors, not ?attr/caloColor... ones: this
  has to look the same regardless of which theme is currently active, since
  it's depicting the OTHER option a user might not be on right now.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="@color/calo_coral"
                android:endColor="@color/calo_orange" />
        </shape>
    </item>

    <item
        android:top="7dp"
        android:bottom="7dp"
        android:left="7dp"
        android:right="7dp">
        <shape android:shape="oval">
            <solid android:color="@color/calo_peach" />
        </shape>
    </item>

    <item
        android:top="20dp"
        android:bottom="20dp"
        android:left="20dp"
        android:right="20dp">
        <shape android:shape="oval">
            <gradient
                android:type="sweep"
                android:startColor="@color/calo_swirl_magenta"
                android:centerColor="@color/calo_swirl_orange"
                android:endColor="@color/calo_swirl_yellow" />
        </shape>
    </item>

</layer-list>
