<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Calo"
        android:theme="@style/Theme.Calo">

        <!--
          The home screen — marble tap for voice, pill button to teach a
          flow. Everything it calls (CaloOrchestrator.startVoiceCommand /
          startTeaching / finishTeaching) already existed before this UI
          pass; this activity is the first real caller of any of it.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Calo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Nav drawer destinations (UI pass, 29 Sep 2026) -->
        <activity
            android:name=".ui.ThemesActivity"
            android:exported="false"
            android:theme="@style/Theme.Calo" />

        <activity
            android:name=".ui.SavedWorkflowsActivity"
            android:exported="false"
            android:theme="@style/Theme.Calo" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Calo" />

        <service
            android:name=".accessibility.CaloAccessibilityService"
            android:exported="false"
            android:label="Calo — Teachable Automation"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver
            android:name=".debug.DebugTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.calo.debug.START_TEACHING" />
                <action android:name="com.calo.debug.FINISH_TEACHING" />
                <action android:name="com.calo.debug.REPLAY_LATEST" />
                <action android:name="com.calo.debug.VOICE_COMMAND" />
                <action android:name="com.calo.debug.SET_TOUCH_EXPLORATION" />
                <action android:name="com.calo.debug.DUMP_FLOWS" />
                <action android:name="com.calo.debug.DELETE_FLOWS_BY_ID" />
                <action android:name="com.calo.debug.DEBUG_RESET" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
