<?xml version="1.0" encoding="utf-8"?>
<!--
  Shown after "Finish Teaching" stops the recording, before the trigger
  phrase / description dialog — only when TeachRecorder captured at least
  one step with a promotable literal (see MainActivity.promotableLabel()).
  slotRowsContainer is populated at runtime, one row per promotable step
  (dialog_promote_slot_row.xml), since the number of rows isn't known until
  teaching finishes and this app has no RecyclerView dependency to lean on.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/dialog_promote_slots_intro"
            android:textColor="@color/calo_text_secondary" />

        <LinearLayout
            android:id="@+id/slotRowsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
