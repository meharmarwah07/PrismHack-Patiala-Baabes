<?xml version="1.0" encoding="utf-8"?>
<!--
  canRetrieveWindowContent is the one that matters most: without it,
  CaloAccessibilityService.rootInActiveWindow returns null and neither
  teaching nor replay can see any UI at all.

  canPerformGestures="true" (27 Sep 2026): replay's fallback when an
  element ignores ACTION_CLICK and only reacts to a real touch (Zomato's
  search box, confirmed on-device) — ReplayEngine then taps its centre via
  dispatchGesture. Used only for that fallback, never to replace a
  node-level action that works.

  canRequestTouchExplorationMode="true" (Finding 6 fallback, 2026-09-26):
  a STATIC, permanent capability declaration — required before
  FLAG_REQUEST_TOUCH_EXPLORATION_MODE means anything at runtime; confirmed
  on-device that setting the flag via setServiceInfo() without this is
  silently ignored (dumpsys accessibility's granted capabilities never
  changed). Declaring it does NOT turn touch exploration on by itself —
  CaloAccessibilityService still only requests the flag for the duration
  of a teach session (see setTouchExplorationCapabilityRequested) — but it
  does mean re-enabling the service in Settings will show a fresh
  capabilities-consent dialog once, on every device this runs on.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeAllMask"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:canRequestFilterKeyEvents="false"
    android:canRequestTouchExplorationMode="true"
    android:canPerformGestures="true"
    android:notificationTimeout="100"
    android:description="@string/accessibility_service_description" />
