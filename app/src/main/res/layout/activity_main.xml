<?xml version="1.0" encoding="utf-8"?>
<!--
  Calo home screen (Theme 3 mock), now wrapped in a DrawerLayout so the
  hamburger opens the shared nav drawer (view_nav_drawer.xml, wired by
  NavDrawerController). Colors are theme attributes (?attr/caloColor...),
  not literal @color values, so Default/BlackWhite (ThemePrefs) both apply
  correctly — see values/themes.xml.

  Deliberately built on FrameLayout/LinearLayout only — the app module has
  no ConstraintLayout dependency (see app/build.gradle.kts) and this pass
  isn't the place to add one sight-unseen with no network access to verify
  the build. Every widget below is plain android.widget, always present.
  DrawerLayout is the one exception: it comes transitively via appcompat's
  own dependency on androidx.drawerlayout, so no new dependency was added.

  Layers, back to front:
    - top bar: hamburger (start) / "Calo" title (center) / profile (end)
    - centered column: the marble, then a status line under it
    - pill button pinned to the bottom, toggles teaching mode

  Wiring lives in MainActivity — this file has no logic of its own.
-->
<androidx.drawerlayout.widget.DrawerLayout
    android:id="@+id/drawerLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/caloColorBackground"
        android:fitsSystemWindows="true">

        <!-- Centered column: marble + status text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="48dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <View
                android:id="@+id/marble"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:contentDescription="@string/marble_content_description"
                android:foreground="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:gravity="center"
                android:text="@string/status_idle"
                android:textColor="?attr/caloColorTextSecondary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Top bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:paddingTop="12dp">

            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start"
                android:layout_marginStart="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_content_description"
                android:padding="8dp"
                android:src="@drawable/ic_menu" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/app_name"
                android:textColor="?attr/caloColorAccentStart"
                android:textSize="20sp" />

            <ImageButton
                android:id="@+id/profileButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:layout_marginEnd="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/profile_content_description"
                android:padding="8dp"
                android:src="@drawable/ic_profile" />

        </FrameLayout>

        <!-- CTA pill, pinned to the bottom -->
        <TextView
            android:id="@+id/teachButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="40dp"
            android:background="@drawable/bg_teach_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minWidth="200dp"
            android:paddingStart="28dp"
            android:paddingTop="14dp"
            android:paddingEnd="28dp"
            android:paddingBottom="14dp"
            android:text="@string/action_start_teaching"
            android:textColor="?attr/caloColorButtonText"
            android:textSize="15sp" />

    </FrameLayout>

    <include layout="@layout/view_nav_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
